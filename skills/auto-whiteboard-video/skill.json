{
  "name": "auto-whiteboard-video",
  "version": "2.0.0",
  "description": "Generate narrated whiteboard videos from text using MiniMax/302 TTS and a gpt-image-2 image provider.",
  "entry": "skill.sh",
  "author": "whiteboard-video-maker",
  "tags": ["video", "whiteboard", "animation", "tts", "subtitles", "agent"],
  "requirements": {
    "python": ">=3.11",
    "system": ["ffmpeg", "ffprobe"]
  },
  "config": {
    "configFile": "../../auto-whiteboard/config/config.ini",
    "imageEnvFile": "../whiteboard-video-workflow/.env",
    "requiredKeys": [
      "MiniMax.api_key",
      "IMAGE_PROVIDER-specific image API key"
    ]
  }
}
