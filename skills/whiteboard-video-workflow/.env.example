# Optional. Required only for platform cover generation through 302.AI.
AI302_KEY=

# Image provider for whiteboard source images.
# Recommended options:
#   apimart_image2
#   kie_image2
#   t8_image2
#   macode_image2
# Legacy option:
#   runninghub
IMAGE_PROVIDER=apimart_image2

# APIMart gpt-image-2 compatible provider.
APIMART_BASE_URL=https://api.apimart.ai/v1
APIMART_API_KEY=your_apimart_api_key_here
APIMART_IMAGE_MODEL=gpt-image-2
APIMART_IMAGE_SIZE=1792x1008
APIMART_IMAGE_RESOLUTION=1k
APIMART_IMAGE_CONCURRENCY=16
APIMART_IMAGE_TIMEOUT=600
APIMART_IMAGE_POLL_INTERVAL=5

# Kie AI image provider.
KIE_BASE_URL=https://api.kie.ai
KIE_API_KEY=your_kie_api_key_here
KIE_IMAGE_MODEL=gpt-image-2-text-to-image
KIE_IMAGE_RESOLUTION=1k
KIE_IMAGE_CONCURRENCY=16
KIE_IMAGE_TIMEOUT=600
KIE_IMAGE_POLL_INTERVAL=5

# T8 image provider.
T8_BASE_URL=https://ai.t8star.cn/v1
T8_API_KEY=your_t8_api_key_here
T8_IMAGE_MODEL=gpt-image-2
T8_IMAGE_SIZE=1792x1008
T8_IMAGE_QUALITY=high
T8_IMAGE_CONCURRENCY=16
T8_IMAGE_ASYNC=true

# macode/OpenAI-compatible image provider.
MACODE_BASE_URL=https://your-openai-compatible-image-host.example/v1
MACODE_API_KEY=your_macode_api_key_here
MACODE_IMAGE_MODEL=gpt-image-2
MACODE_IMAGE_SIZE=1792x1008
MACODE_IMAGE_QUALITY=high
MACODE_IMAGE_CONCURRENCY=8

# Legacy RunningHub image provider.
RUNNINGHUB_API_KEY=your_runninghub_api_key_here
